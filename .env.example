# Public Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin
TROUVETOU_SUPABASE_URL=
TROUVETOU_SUPABASE_SERVICE_ROLE_KEY=

# Refontiq Control Center
CONTROL_CENTER_URL=https://refontiq-control-center.vercel.app
METRICS_PUSH_SECRET=

# URL publique du site (sert de contrôle d'origine sur /api/catalog/bookings)
NEXT_PUBLIC_SITE_URL=https://trouvetou.vercel.app
# Origines supplémentaires acceptées, séparées par des virgules
# (previews Vercel, staging…). À laisser vide en production si inutile.
BOOKING_ALLOWED_ORIGINS=

# Secret serveur autorisant l'action "cancel" de /api/catalog/bookings
# (x-booking-management-secret). Sans lui, l'annulation est désactivée (503).
BOOKING_MANAGEMENT_SECRET=
