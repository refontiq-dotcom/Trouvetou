# ============================================================================
# TROUVETOU — Variables d'environnement (exemple)
# Copier ce fichier vers `.env.local` et compléter les valeurs.
# ============================================================================

# --- Supabase (lecture publique) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase admin (server-only, ingestion /api/v1/sync) ---
TROUVETOU_SUPABASE_URL=
TROUVETOU_SUPABASE_SERVICE_ROLE_KEY=

# --- URL canonique du site (pour les liens OpenGraph, sitemap, etc.) ---
NEXT_PUBLIC_SITE_URL=https://trouvetou.vercel.app

# --- Intégration Schooly (partenaires écoles) -----------------------------
# URL de base de l'instance Schooly (sans slash final).
SCHOOLY_API_URL=https://schooly.example.com

# Clé partagée avec Schooly (côté serveur uniquement, JAMAIS NEXT_PUBLIC_).
# Le nom recommandé par Schooly est TROUVETOU_API_KEY_PEPPER. L'ancien nom
# TROUVETOU_API_KEY reste accepté comme fallback de compatibilité.
TROUVETOU_API_KEY_PEPPER=
